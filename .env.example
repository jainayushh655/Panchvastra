# Optional production API origin for the storefront fetch layer
# VITE_API_URL=https://api.yourdomain.com

# Admin panel token (default: pv-admin-demo).
# VITE_ADMIN_TOKEN=your-secret-token

# WhatsApp: country code + number, digits only (no +). Opens wa.me after checkout submit.
# VITE_WHATSAPP_NUMBER=919876543210

# Optional: full Instagram profile URL (default https://www.instagram.com/panchvastra/)
# VITE_INSTAGRAM_URL=https://www.instagram.com/panchvastra/

# --- Local API (Express) — started with `npm run dev` ---
# Vite proxies /api → this port. Orders append to server/data/orders.csv (gitignored).

EMAIL_API_PORT=8787
PUBLIC_SITE_URL=http://localhost:5173

# Optional: custom path for the orders CSV (absolute or relative to project root)
# ORDERS_CSV_PATH=server/data/orders.csv
