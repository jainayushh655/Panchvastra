# ─────────────────────────────────────────────────────────────────────────────
# PANCHVASTRA — Next.js application environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this file is
# documentation and is never read by Next at runtime.
#
# This configuration is INDEPENDENT of the Vite application in the repository
# root. Its `VITE_*` variables are not read here and must not be copied in —
# the two applications stay separately configured for the whole migration so a
# change to one cannot move the other.
#
# Every variable below is OPTIONAL in Phase 2. With none of them set,
# `npm run dev`, `typecheck`, `lint` and `build` all work: the API base falls
# back to a same-origin relative path and no network call is made.
# ─────────────────────────────────────────────────────────────────────────────


# ─── API ─────────────────────────────────────────────────────────────────────

# What the BROWSER prefixes its API requests with.
#
# Leave EMPTY (recommended). An empty value means "same origin": the browser
# calls `/v1/...` on the Next server, and the `/v1/:path*` rewrite in
# next.config.ts forwards it to API_ORIGIN below. That is the equivalent of the
# Vite dev server's `/v1` proxy, and it means no CORS preflight and no backend
# origin baked into the JavaScript bundle.
#
# Set it to an absolute origin only if you deliberately want the browser to call
# the API directly — the backend must then allow this app's origin via CORS.
# Must be an absolute http(s) URL with no trailing slash; a malformed value
# fails the build rather than failing at runtime.
NEXT_PUBLIC_API_BASE_URL=

# The absolute upstream origin the SERVER talks to.
#
# Used by the `/v1` rewrite and by Server Components (`services/server/serverApi.ts`),
# which cannot use a relative URL — there is no origin on the server to be
# relative to. Server-only: no NEXT_PUBLIC_ prefix, so it is never sent to the
# browser.
#
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# Point this at a staging backend for development. Do NOT point a development
# environment at the production API.
# API_ORIGIN=https://staging-api.example.com


# ─── Site ────────────────────────────────────────────────────────────────────

# Canonical public origin, used for `metadataBase` so Open Graph and canonical
# URLs resolve absolutely. Leave empty on a preview deployment — Next then emits
# relative URLs, which is correct for one. Needed in Phase 7.
# NEXT_PUBLIC_SITE_URL=https://www.panchvastra.com


# ─── Google sign-in ──────────────────────────────────────────────────────────

# OAuth 2.0 **Web application** CLIENT ID from the Google Cloud Console.
# Public by design: it ships in the browser bundle.
#
# NEVER put the client SECRET here, or anywhere in this application.
#
# Google Cloud > Credentials > Authorized JavaScript origins must list this
# app's origin. Note the port differs from the Vite app: Next dev serves on
# http://localhost:3000, not :5173. The preview and production origins need
# listing too, or sign-in fails with no useful error.
#
# Needed in Phase 4. Unset simply hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ─── Storefront contact details ──────────────────────────────────────────────
# All three have in-code defaults in `src/lib/siteUrls.ts`; set them only to
# override. Equivalents of the Vite app's VITE_WHATSAPP_NUMBER /
# VITE_INSTAGRAM_URL / VITE_SUPPORT_EMAIL.

# Country code first, digits only, no `+` and no spaces. Drives both the
# WhatsApp chat link and click-to-call.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Full Instagram profile URL.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/panchvastra_

# Support inbox, for a staging address.
# NEXT_PUBLIC_SUPPORT_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# NOT ENVIRONMENT VARIABLES — recorded so nobody adds them here later
#
#   The JWT          — issued by the backend, held in browser storage only.
#                      Phase 5 moves it into an httpOnly cookie. It is never
#                      read from or written to an environment variable.
#   Razorpay key id  — returned by POST /v1/checkout_payment/ per order and used
#                      verbatim. The key SECRET stays on the backend and must
#                      never appear in this application.
#   Admin token      — there is no admin API token. Admin access is the
#                      backend-issued role on the customer JWT (`role_id === 1`).
#                      The Vite app's unused VITE_ADMIN_TOKEN is dead code and
#                      is deliberately not carried over.
# ─────────────────────────────────────────────────────────────────────────────
